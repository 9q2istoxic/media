# ------------------------------------------------------------------
# Copia este archivo a .env y rellena los valores. NO subas .env a git.
# ------------------------------------------------------------------

# --- Discord (bot) ---
DISCORD_TOKEN=pon_aqui_el_token_del_bot
DISCORD_CLIENT_ID=pon_aqui_el_client_id
DISCORD_GUILD_ID=pon_aqui_el_guild_id
APPLICATIONS_CHANNEL_ID=canal_donde_se_publican_las_applys
REVIEW_STAFF_ROLE_ID=rol_que_puede_aceptar_o_rechazar

# --- Login con Discord (OAuth2) ---
# El CLIENT_SECRET está en Developer Portal > tu app > OAuth2.
DISCORD_CLIENT_SECRET=pon_aqui_el_client_secret
# Debe coincidir EXACTAMENTE con un "Redirect" añadido en OAuth2 del portal.
OAUTH_REDIRECT_URI=https://apply.tudominio.com/auth/discord/callback

# --- Sesión ---
# Cadena larga y aleatoria. Genera una con:  openssl rand -hex 32
SESSION_SECRET=cambia_esto_por_algo_muy_largo_y_aleatorio

# --- Web ---
PORT=30043
HOST=0.0.0.0
# URL pública real (con https si tienes dominio). Se usa para marcar las cookies como seguras.
PUBLIC_BASE_URL=https://apply.tudominio.com
BASE_URL=http://127.0.0.1:30043
# Pon 1 SOLO cuando haya un Nginx real delante (ver README) - si no, req.ip
# deja de ser la IP real del visitante y rompe el rate limiter, el AntiVPN y la blacklist por IP.
TRUST_PROXY=

# --- AntiVPN (opcional) ---
# Gratis en https://iphub.info (1000 consultas/día). Sin esto configurado,
# el chequeo de VPN/proxy simplemente no se hace (no bloquea por defecto).
IPHUB_API_KEY=

# --- Cloudflare Turnstile en el login (opcional) ---
# Cloudflare Dashboard > Turnstile > Add widget. Sin las dos, no se activa nada.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Checker de anuncios (opcional) ---
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# App de https://kick.com/settings/developer (OAuth2 client_credentials, igual que Twitch)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
POLL_INTERVAL_MINUTES=1
VIDEO_NOTIFICATION_CHANNEL_ID=
LIVE_NOTIFICATION_CHANNEL_ID=
